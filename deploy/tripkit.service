[Unit]
Description=Tripkit MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tripkit
Group=tripkit
WorkingDirectory=/opt/tripkit/app
EnvironmentFile=/etc/tripkit.env
ExecStart=/usr/bin/node dist/cli/index.js mcp --http --port 4700 --host 127.0.0.1 --public-url https://147-224-167-3.sslip.io
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
