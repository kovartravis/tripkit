# Copy to .env.local (gitignored) and fill in real values to run the live-Postgres
# integration tests in test/postgres/. Get these from the Supabase dashboard for the
# project: Project Settings > API (the three SUPABASE_* keys) and Database > Settings
# (the SUPABASE_DB_* connection details — use the "Session pooler" host/user, not the
# direct-connection host, unless your network has outbound IPv6).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
